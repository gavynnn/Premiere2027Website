# Server-only. Set your real key in .env, never in this example or browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8000
APP_ORIGIN=http://127.0.0.1:8000
# Maximum paid chat requests across all visitors per UTC day.
CHAT_DAILY_LIMIT=3000
CHAT_IP_DAILY_LIMIT=25
CHAT_IP_PER_MINUTE=5
CHAT_GLOBAL_PER_MINUTE=12
CHAT_COOLDOWN_SECONDS=8
CHAT_MAX_OUTPUT_TOKENS=400
# Only enable behind a loopback reverse proxy that appends the real client IP.
TRUST_LOOPBACK_PROXY=false
